    "obsidian",
    "plugin"
  ],
  "author": "Hyunyoung Park",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.10.0",
    "@types/node": "^20.11.30",
    "esbuild": "^0.28.1",
    "obsidian": "^1.8.7",
    "typescript": "^5.4.5"
  }
}
