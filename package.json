{
  "name": "obsidian-editor-uxfix",
  "version": "0.2.2",
  "description": "Fold and unfold lines with long-press, clicks, and the mouse wheel, keeping the line under the mouse in place",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "plugin"
  ],
  "author": "Hyunyoung Park",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^20.11.30",
    "esbuild": "^0.28.1",
    "obsidian": "^1.8.7",
    "typescript": "^5.4.5"
  }
}
